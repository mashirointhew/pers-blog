---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import HomeSidebarSection from '../components/HomeSidebarSection.astro';
import { getPublishedLinks, getPublishedPosts, getPublishedProjects, getTagMap } from '../lib/content';
import { siteSettings } from '../lib/site-settings';

const posts = await getPublishedPosts();
const featuredPosts = posts.filter((post) => post.data.featured);
const featuredLinks = (await getPublishedLinks()).filter((link) => link.data.featured);
const featuredProjects = (await getPublishedProjects()).filter((project) => project.data.featured);
const tags = Object.keys(await getTagMap()).sort((a, b) => a.localeCompare(b));
---

<BaseLayout>
  <section class="shell home-shell pb-20 pt-12 lg:pt-16">
    <div class="home-lower">
      <div>
        <div class="mb-6 flex items-baseline justify-between">
          <h1 class="mono text-xs uppercase tracking-[.2em] text-[var(--muted)]">{siteSettings.pages.home.recentTitle}</h1>
          <a href="/blog/" class="text-sm text-[var(--accent)]">{siteSettings.pages.home.allPostsLabel} →</a>
        </div>
        {posts.slice(0, siteSettings.home.recentPostLimit).map((post) => <PostCard post={post} />)}
      </div>
      <aside class="home-aside">
        {siteSettings.home.sidebarSections.filter((section) => section.visible).map((section) => <HomeSidebarSection section={section} tags={tags} posts={featuredPosts} projects={featuredProjects} links={featuredLinks} description={siteSettings.site.homeDescription} />)}
      </aside>
    </div>
  </section>
</BaseLayout>
