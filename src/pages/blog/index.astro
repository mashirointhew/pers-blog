---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PostCard from '../../components/PostCard.astro'; import BlogSidebar from '../../components/BlogSidebar.astro'; import { getPosts } from '../../lib/posts'; const posts=await getPosts();
---
<BaseLayout title="Blog"><section class="shell page-with-sidebar pb-20 pt-16 lg:pt-24"><div><p class="mono text-xs uppercase tracking-[.2em] text-[var(--muted)]">Posts</p><h1 class="serif mt-5 text-6xl tracking-tight">Writing</h1><p class="mt-5 max-w-xl text-lg leading-8 text-[var(--muted)]">Articles and notes on things I find interesting.</p><div class="mt-16 archive-list">{posts.map(post=><PostCard post={post}/>)}</div></div><BlogSidebar /></section></BaseLayout>
