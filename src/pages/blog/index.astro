---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import { getPublishedPosts } from '../../lib/content';
import { siteSettings } from '../../lib/site-settings';

const posts = await getPublishedPosts();
---

<BaseLayout title={siteSettings.pages.blog.title} description={siteSettings.pages.blog.description}>
  <section class="shell page-with-sidebar pb-20 pt-16 lg:pt-24">
    <div>
      <p class="mono text-xs uppercase tracking-[.2em] text-[var(--muted)]">{siteSettings.pages.blog.eyebrow}</p>
      <h1 class="serif mt-5 text-6xl tracking-tight">{siteSettings.pages.blog.title}</h1>
      <p class="mt-5 max-w-xl text-lg leading-8 text-[var(--muted)]">{siteSettings.pages.blog.description}</p>
      <div class="mt-16 archive-list">{posts.map((post) => <PostCard post={post} />)}</div>
    </div>
    <BlogSidebar />
  </section>
</BaseLayout>
