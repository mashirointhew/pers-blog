---
import { render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import BlogSidebar from '../../components/BlogSidebar.astro'; import PostReferences from '../../components/PostReferences.astro'; import { formatDate, getPublishedPosts, tagPath, contentSlug } from '../../lib/content'; import { getPostReferences } from '../../lib/references';
export async function getStaticPaths(){const posts=await getPublishedPosts();return posts.map(post=>({params:{slug:contentSlug(post.id)},props:{post}}))} const {post}=Astro.props; const {Content}=await render(post); const references=getPostReferences(post.body ?? '',post.data.references);
---
<BaseLayout title={post.data.title} description={post.data.description}><div class="shell page-with-sidebar article-shell pb-20 pt-16 lg:pt-24"><article><header class="border-b border-[var(--line)] pb-10"><div class="flex flex-wrap gap-3 text-xs text-[var(--muted)]"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.tags.map((tag:string)=><a class="mono uppercase tracking-wider" href={tagPath(tag)}>#{tag}</a>)}</div><h1 class="serif mt-6 text-5xl leading-[1.02] tracking-tight sm:text-7xl">{post.data.title}</h1><p class="mt-6 max-w-2xl text-xl leading-8 text-[var(--muted)]">{post.data.description}</p></header><div class="prose-custom mt-12"><Content/></div></article>{(post.data.tags.length > 0 || references.length > 0) && <div class="article-rail">{post.data.tags.length > 0 && <BlogSidebar currentPostId={post.id} postTags={post.data.tags} />}<PostReferences references={references} /></div>}</div></BaseLayout>
