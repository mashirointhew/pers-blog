---
import { siteSettings } from '../lib/site-settings';
---
<footer class="site-footer"><div class="shell footer-inner"><span>{siteSettings.site.footerText.replace('{year}', String(new Date().getFullYear())).replace('{name}', siteSettings.site.name)}</span><div>{siteSettings.site.footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}</div></div></footer>
