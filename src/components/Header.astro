---
import { siteSettings } from '../lib/site-settings';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${siteSettings.site.name} home`}>
      <svg class="brand-mark" aria-hidden="true" viewBox="0 0 32 32" fill="none">
        <path class="brand-mark-page" d="M7.5 4.75h11l6 6v16.5h-17V4.75Z" />
        <path class="brand-mark-fold" d="M18.5 4.75v6h6" />
        <path class="brand-mark-line" d="M11.5 16.25h9m-9 4h6" />
      </svg>
      <span class="brand-name serif">{siteSettings.site.name}<span class="brand-period">.</span></span>
    </a>
    <nav aria-label="Main navigation" class="main-nav">
      {siteSettings.site.navigation.filter((item) => item.visible).map((item) => <a href={item.href}>{item.label}</a>)}
      <div id="header-search" class="header-search" aria-hidden="true" inert>
        <label class="sr-only" for="header-search-input">Search posts</label>
        <input id="header-search-input" class="search-input" type="search" placeholder="Search posts" autocomplete="off" tabindex="-1" />
        <div class="header-search-popover">
          <p id="header-search-status" class="search-status" role="status" aria-live="polite">Type to search posts.</p>
          <div id="header-search-results" class="header-search-results"></div>
        </div>
      </div>
      <button id="search-toggle" class="nav-search" type="button" aria-expanded="false" aria-controls="header-search">Search</button>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme">Aa</button>
    </nav>
  </div>
</header>

<script>
  import { bindPagefindSearch } from '../scripts/pagefind-search';

  const toggle = document.querySelector<HTMLButtonElement>('#search-toggle');
  const panel = document.querySelector<HTMLElement>('#header-search');
  const input = document.querySelector<HTMLInputElement>('#header-search-input');
  const output = document.querySelector<HTMLDivElement>('#header-search-results');
  const status = document.querySelector<HTMLParagraphElement>('#header-search-status');
  const searchTriggers = () => Array.from(document.querySelectorAll<HTMLButtonElement | HTMLAnchorElement>('#search-toggle, [data-toggle-search]'));
  let lastSearchTrigger: HTMLElement | null = toggle;
  bindPagefindSearch({
    input,
    output,
    status,
    emptyMessage: 'Type to search posts.',
    limit: 8,
  });

  function openSearch() {
    if (!panel || !toggle) return;
    panel.classList.add('is-open');
    panel.removeAttribute('inert');
    panel.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    for (const trigger of searchTriggers()) trigger.setAttribute('aria-expanded', 'true');
    input?.removeAttribute('tabindex');
    input?.focus();
  }

  function closeSearch(restoreFocus = true) {
    if (!panel || !toggle) return;
    panel.classList.remove('is-open');
    panel.setAttribute('inert', '');
    panel.setAttribute('aria-hidden', 'true');
    input?.setAttribute('tabindex', '-1');
    toggle.setAttribute('aria-expanded', 'false');
    for (const trigger of searchTriggers()) trigger.setAttribute('aria-expanded', 'false');
    if (restoreFocus) (lastSearchTrigger ?? toggle).focus();
  }

  if (toggle && !toggle.dataset.bound) {
    toggle.dataset.bound = 'true';
    toggle.addEventListener('click', () => {
      lastSearchTrigger = toggle;
      if (!panel?.classList.contains('is-open')) openSearch();
      else closeSearch();
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    const trigger = target instanceof Element ? target.closest<HTMLElement>('[data-toggle-search]') : null;
    if (trigger) {
      event.preventDefault();
      lastSearchTrigger = trigger;
      if (!panel?.classList.contains('is-open')) openSearch();
      else closeSearch(false);
    }
  });

  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      lastSearchTrigger = toggle;
      openSearch();
    } else if (event.key === 'Escape' && panel?.classList.contains('is-open')) {
      closeSearch();
    }
  });
</script>
